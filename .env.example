# --- Core ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql://a11y:a11y@localhost:5432/a11y
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me-too
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App (fix engine) ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

# --- Queue: bullmq (local) | pubsub (prod) ---
QUEUE_DRIVER=bullmq
PUBSUB_TOPIC=a11y-jobs
PUBSUB_SUBSCRIPTION=a11y-jobs-agents

# --- Storage: local (dev) | gcs (prod) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
GCS_BUCKET=

# --- Limits ---
RUN_TIMEOUT_SECONDS=300
RUN_COST_CAP_USD=1.00
MAX_STEPS=40

# --- URLs ---
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
